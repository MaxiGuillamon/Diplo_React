<h1 class="mb-4">Novedades</h1>

<div class="container">
    <div class="row mb-3">
        <div class="col text-end">
            <p>
                Hola {{usuario}}!
                <a class="btn btn-danger ms-2" href="/admin/logout">
                    Cerrar Sesión <i class="fas fa-sign-out-alt"></i>
                </a>
            </p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <h3>Listado de Novedades</h3>
        </div>
        <div class="col-6 text-end">
            <a class="btn btn-success" href="/admin/novedades/agregar">
                <i class="fa fa-plus"></i> Nueva Novedad
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Título</th>
                            <th>Subtítulo</th>
                            <th>Cuerpo</th>
                            <th class="text-center">Imagen</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each novedades}}
                        <tr>
                            <td>{{id}}</td>
                            <td class="fw-bold">{{titulo}}</td>
                            <td>{{subtitulo}}</td>
                            <td style="max-width: 300px;">
                                <div class="text-truncate">
                                    {{cuerpo}}
                                </div>
                            </td>
                            <td class="text-center">
                                {{#if imagen}}
                                    <img src="{{{imagen}}}" width="80" class="img-thumbnail">
                                {{else}}
                                    <span class="text-muted">Sin imagen</span>
                                {{/if}}
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-secondary"
                                   href="/admin/novedades/modificar/{{id}}">
                                    <i class="fa fa-pencil"></i>
                                </a>
                                <a class="btn btn-sm btn-danger"
                                   href="/admin/novedades/eliminar/{{id}}">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
