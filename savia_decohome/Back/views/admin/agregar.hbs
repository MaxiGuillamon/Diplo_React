<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <h3 class="text-center mb-4">Agregar Novedad</h3>

      <form action="/admin/novedades/agregar" method="post" enctype="multipart/form-data">
        <div class="mb-3">
          <input type="text" class="form-control" placeholder="Título" name="titulo" required>
        </div>

        <div class="mb-3">
          <textarea type="text" class="form-control" placeholder="Subtitulo" name="subtitulo" required></textarea>
        </div>

        <div class="mb-3">
          <textarea class="form-control" placeholder="Cuerpo" name="cuerpo" rows="5" required></textarea>
        </div>
        <div class="mb-3">
          <label>Imagen: <input type="file" name="imagen" id="imagen"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100">
          Guardar
        </button>
      </form>

    </div>
  </div>